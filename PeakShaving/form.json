{
  "elements": [
    {
      "type": "CheckBox",
      "name": "Enabled",
      "caption": "Regelung aktivieren"
    },
    {
      "type": "Select",
      "name": "PowerUnit",
      "caption": "Globale Leistungseinheit",
      "options": [
        {
          "caption": "Watt (W)",
          "value": "W"
        },
        {
          "caption": "Kilowatt (kW)",
          "value": "kW"
        }
      ],
      "onChange": "PS_ConfigureForm($id, $BatteryMode, $PowerUnit);"
    },
    {
      "type": "SelectVariable",
      "name": "GridPower",
      "caption": "Netzleistung ({unit}, positiv = Bezug)"
    },
    {
      "type": "Select",
      "name": "Distribution",
      "caption": "Verteilung: Gleichmäßig oder Reihenfolge",
      "options": [
        {
          "caption": "Nach Reihenfolge",
          "value": "priority"
        },
        {
          "caption": "Gleichmäßig verteilen",
          "value": "equal"
        }
      ]
    },
    {
      "type": "CheckBox",
      "name": "InvertGrid",
      "caption": "Netzleistung: Bezug ist negativ"
    },
    {
      "type": "Label",
      "caption": "Gleichmäßig: Leistungsbudget auf alle automatischen Verbraucher verteilen. Reihenfolge: zuerst kleinere Nummern versorgen, größere zuerst reduzieren."
    },
    {
      "type": "NumberSpinner",
      "name": "Target",
      "caption": "Zielnetzbezug ({unit})",
      "digits": 2
    },
    {
      "type": "Select",
      "name": "UpdateMode",
      "caption": "Regelung auslösen",
      "options": [
        {
          "caption": "Nach Sekunden",
          "value": "timer"
        },
        {
          "caption": "Bei Änderung der Netzvariable",
          "value": "change"
        }
      ],
      "onChange": "PS_ConfigureUpdateMode($id, $UpdateMode);"
    },
    {
      "type": "NumberSpinner",
      "name": "Hysteresis",
      "caption": "Hysterese ± {unit}",
      "digits": 2
    },
    {
      "type": "NumberSpinner",
      "name": "Interval",
      "caption": "Regelintervall (Sekunden, nur Zeitsteuerung)",
      "digits": 0
    },
    {
      "type": "CheckBox",
      "name": "PeakOverridesHold",
      "caption": "Bei Zielüberschreitung Laufzeiten und Verzögerungen übersteuern"
    },
    {
      "type": "NumberSpinner",
      "name": "MaxAge",
      "caption": "Maximales Messwertalter (Sekunden)",
      "digits": 0
    },
    {
      "type": "Label",
      "caption": "Batterie optional: freie Lade-/Entladevariablen und SOC. Ohne Istleistung wird aus Sollwerten geschätzt."
    },
    {
      "type": "Select",
      "name": "BatteryMode",
      "caption": "Batterie-Sollwerte",
      "options": [
        {
          "caption": "Getrennte Lade-/Entladevariablen",
          "value": "separate"
        },
        {
          "caption": "Gemeinsamer Leistungssollwert",
          "value": "signed"
        }
      ],
      "onChange": "PS_ConfigureForm($id, $BatteryMode, $PowerUnit);"
    },
    {
      "type": "SelectVariable",
      "name": "BatteryCharge",
      "caption": "Laden: Leistungssollwert ({unit})"
    },
    {
      "type": "SelectVariable",
      "name": "BatteryDischarge",
      "caption": "Entladen: Leistungssollwert ({unit})"
    },
    {
      "type": "CheckBox",
      "name": "InvertCharge",
      "caption": "Ladesollwert negativ schreiben"
    },
    {
      "type": "CheckBox",
      "name": "InvertDischarge",
      "caption": "Entladesollwert negativ schreiben"
    },
    {
      "type": "CheckBox",
      "name": "InvertBatteryCommand",
      "caption": "Gemeinsamer Sollwert: positiv = Laden",
      "visible": false
    },
    {
      "type": "SelectVariable",
      "name": "BatteryActual",
      "caption": "Gemessene Batterie-Leistung ({unit}, optional; eigenes Vorzeichen)"
    },
    {
      "type": "SelectVariable",
      "name": "BatterySetpoint",
      "caption": "Batterie-Leistungssollwert ({unit})",
      "visible": false
    },
    {
      "type": "NumberSpinner",
      "name": "MaxDischarge",
      "caption": "Maximale Entladeleistung ({unit})",
      "digits": 0
    },
    {
      "type": "NumberSpinner",
      "name": "MaxCharge",
      "caption": "Maximale Ladeleistung ({unit})",
      "digits": 0
    },
    {
      "type": "NumberSpinner",
      "name": "MinSOC",
      "caption": "Minimaler Ladezustand (%)",
      "digits": 2,
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "NumberSpinner",
      "name": "MaxSOC",
      "caption": "Maximaler Ladezustand (%)",
      "digits": 2,
      "minimum": 0,
      "maximum": 100
    },
    {
      "type": "SelectVariable",
      "name": "SOC",
      "caption": "Ladezustand (%) – optional, 0 = ohne SOC-Grenzprüfung"
    },
    {
      "type": "Select",
      "name": "InvertBattery",
      "caption": "Vorzeichen der gemessenen Batterie-Leistung (unabhängig vom Sollwert)",
      "options": [
        {
          "caption": "Positiv = Entladen, negativ = Laden",
          "value": false
        },
        {
          "caption": "Positiv = Laden, negativ = Entladen",
          "value": true
        }
      ]
    },
    {
      "type": "List",
      "name": "Consumers",
      "caption": "Verbraucher / Wallboxen",
      "rowCount": 5,
      "add": true,
      "delete": true,
      "columns": [
        {
          "name": "Name",
          "caption": "Name",
          "width": "180px",
          "add": "",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "Setpoint",
          "caption": "Aktionsvariable",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "name": "ActualPower",
          "caption": "Aktueller Verbrauch {unit} (optional)",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "SelectVariable"
          }
        },
        {
          "name": "Unit",
          "caption": "Einheit",
          "width": "180px",
          "add": "W",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "Watt",
                "value": "W"
              },
              {
                "caption": "Ampere",
                "value": "A"
              },
              {
                "caption": "Ein/Aus",
                "value": "Switch"
              },
              {
                "caption": "Skalierter Sollwert (z. B. %)",
                "value": "Scale"
              }
            ]
          }
        },
        {
          "name": "Priority",
          "caption": "Reihenfolge (1 = zuerst versorgen)",
          "width": "180px",
          "add": 1,
          "edit": {
            "type": "NumberSpinner",
            "digits": 0
          }
        },
        {
          "name": "Max",
          "caption": "Maximum (Ein/Aus: Einschaltleistung {unit})",
          "width": "180px",
          "add": 11000,
          "edit": {
            "type": "NumberSpinner",
            "digits": 2
          }
        },
        {
          "name": "Min",
          "caption": "Minimaler aktiver Sollwert",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "NumberSpinner",
            "digits": 2
          }
        },
        {
          "name": "Step",
          "caption": "Schrittweite",
          "width": "180px",
          "add": 100,
          "edit": {
            "type": "NumberSpinner",
            "digits": 2
          }
        },
        {
          "name": "Voltage",
          "caption": "Spannung (V)",
          "width": "180px",
          "add": 230,
          "edit": {
            "type": "NumberSpinner",
            "digits": 2
          }
        },
        {
          "name": "Phases",
          "caption": "Phasen",
          "width": "180px",
          "add": 3,
          "edit": {
            "type": "NumberSpinner",
            "digits": 0
          }
        },
        {
          "name": "ZeroToOne",
          "caption": "0 A als 1 A schreiben (Mennekes)",
          "width": "180px",
          "add": false,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "name": "MaxPower",
          "caption": "Maximaler Verbrauch {unit} (skalierter Sollwert)",
          "width": "180px",
          "add": 5000,
          "edit": {
            "type": "NumberSpinner",
            "digits": 2
          }
        },
        {
          "name": "PerPhaseW",
          "caption": "Leistungs-Sollwert pro Phase",
          "width": "180px",
          "add": false,
          "edit": {
            "type": "CheckBox"
          }
        },
        {
          "name": "MinRuntime",
          "caption": "Mindestlaufzeit (s)",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "NumberSpinner",
            "digits": 0
          }
        },
        {
          "name": "FollowUp",
          "caption": "Nachlaufzeit (s)",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "NumberSpinner",
            "digits": 0
          }
        },
        {
          "name": "Delay",
          "caption": "Verzögerung nach Anpassung (s)",
          "width": "180px",
          "add": 0,
          "edit": {
            "type": "NumberSpinner",
            "digits": 0
          }
        },
        {
          "name": "Mode",
          "caption": "Modus",
          "width": "180px",
          "add": "Auto",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "Automatisch",
                "value": "Auto"
              },
              {
                "caption": "Aktiv",
                "value": "On"
              },
              {
                "caption": "Inaktiv",
                "value": "Off"
              }
            ]
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Jetzt regeln",
      "onClick": "PS_Control($id);"
    },
    {
      "type": "Button",
      "caption": "Diagnosebericht erstellen",
      "onClick": "echo PS_GenerateDiagnostics($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Bereit"
    },
    {
      "code": 104,
      "icon": "inactive",
      "caption": "Deaktiviert"
    },
    {
      "code": 200,
      "icon": "error",
      "caption": "Konfiguration / Messwerte prüfen"
    }
  ]
}
